    },
    {
      "parameters": {
        "jsCode": "// Normaliza la respuesta de ML (fullResponse) a un formato simple para la app.\n// Ojo: si el item usa inventario combinado (Full + deposito propio, tiene inventory_id),\n// ML puede rechazar el PUT directo de available_quantity; el mensaje de error queda visible.\nconst res = $input.first().json;\nconst statusCode = res.statusCode ?? 200;\nconst body = res.body ?? res;\n\nif (statusCode >= 200 && statusCode < 300) {\n  return [{ json: { success: true, item_id: body.id, available_quantity: body.available_quantity } }];\n}\n\nconst mensaje = body?.message || body?.cause?.[0]?.message || 'Error al actualizar el stock en MercadoLibre';\nreturn [{ json: { success: false, error: mensaje, statusCode } }];"
      },
