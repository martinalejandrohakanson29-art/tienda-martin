    {
      "parameters": {
        "jsCode": "const res = $input.first().json; // { statusCode, headers, body }\nconst statusCode = res.statusCode ?? 200;\nconst body = res.body ?? res;\nconst itemId = $('Edit Fields').first().json.item_id;\nconst nuevoStock = $('Edit Fields').first().json.nuevo_stock;\n\nif (statusCode >= 200 && statusCode < 300) {\n  return [{ json: { success: true, item_id: body.id ?? itemId, available_quantity: body.available_quantity ?? nuevoStock } }];\n}\n\nconst mensaje = body?.message || body?.cause?.[0]?.message || 'Error al actualizar el stock en MercadoLibre';\nreturn [{ json: { success: false, error: mensaje, statusCode } }];"
      },
