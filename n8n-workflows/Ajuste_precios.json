      "parameters": {
        "jsCode": "// Consolida resultados: separa OK de errores\nconst results = $input.all();\nconst ok = results.filter(r => r.json.id).length;\nconst errores = results.filter(r => !r.json.id).map(r => r.json);\nreturn [{ json: { total: results.length, ok, errores } }];"
      },
