      "id": "c1a10001-0000-4000-8000-000000000001",
      "name": "Buscar descuento",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Se ejecuta UNA VEZ POR ÍTEM (modo Run once for each item).\n// Detecta si el ítem ya tiene un PRICE_DISCOUNT APLICADO (no un mero candidato),\n// porque en ese caso ML rechaza el POST con \"No candidates found for item\".\n// OJO 1: el PRICE_DISCOUNT propio viene SIN 'id' (a diferencia de las campañas\n//        SMART/DEAL que sí traen promotion_id). Por eso NO exigimos id.\n// OJO 2: con \"Full Response\" la respuesta llega como { body: [...] }; igual\n//        buscamos las promociones de forma recursiva, sin asumir la clave.\nconst original = $('Expandir items').item.json;\nconst resp = $json;\n\n// Junta recursivamente todo objeto que parezca una promoción (tiene 'type').\nfunction collectPromos(node, acc, depth) {\n  if (!node || depth > 6) return acc;\n  if (Array.isArray(node)) {\n    for (const el of node) collectPromos(el, acc, depth + 1);\n    return acc;\n  }\n  if (typeof node === 'object') {\n    if (typeof node.type === 'string' && ('status' in node || 'original_price' in node)) {\n      acc.push(node);\n    }\n    for (const k of Object.keys(node)) {\n      const v = node[k];\n      if (v && typeof v === 'object') collectPromos(v, acc, depth + 1);\n    }\n  }\n  return acc;\n}\n\nconst promos = collectPromos(resp, [], 0);\n\n// 'candidate' = ofrecido pero no aplicado; el resto (started/pending/...) está activo.\nconst NO_APLICADO = ['candidate', 'finished', 'expired', 'deleted'];\nconst activo = promos.find(p =>\n  p && p.type === 'PRICE_DISCOUNT' &&\n  !NO_APLICADO.includes(String(p.status || '').toLowerCase())\n);\n\n// El PRICE_DISCOUNT propio se borra por tipo (sin promotion_id). Si por algún\n// caso viniera con id, lo incluimos igual.\nconst promotion_id = activo && activo.id ? activo.id : null;\nconst delete_query = promotion_id\n  ? `promotion_id=${promotion_id}&promotion_type=PRICE_DISCOUNT`\n  : 'promotion_type=PRICE_DISCOUNT';\n\nreturn {\n  json: {\n    item_id: original.item_id,\n    nuevo_precio: original.nuevo_precio,\n    precio_original: original.precio_original,\n    tiene_descuento: !!activo,\n    promotion_id,\n    delete_query,\n    _promos_encontradas: promos.length,\n  }\n};"
      },
