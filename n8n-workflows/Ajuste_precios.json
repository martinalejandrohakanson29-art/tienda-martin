    {
      "parameters": {
        "jsCode": "// Consolida resultados: separa OK de errores\n// Respuesta exitosa de seller-promotions: { price, original_price }\nconst results = $input.all();\nconst ok = results.filter(r => r.json.price != null).length;\nconst errores = results.filter(r => r.json.price == null).map(r => r.json);\nreturn [{ json: { total: results.length, ok, errores } }];"
      },
