      "name": "Get Questions"
    },
    {
      "parameters": {
        "jsCode": "// Filtra preguntas recientes no borradas del listing\nconst DIAS_RECIENTES = 3;\nconst ahora = new Date();\nconst corte = new Date(ahora.getTime() - DIAS_RECIENTES * 24 * 60 * 60 * 1000);\n\nconst preguntas = ($json.questions || [])\n  .filter(q => q.status === 'UNANSWERED')\n  .filter(q => q.deleted_from_listing !== true)\n  .filter(q => new Date(q.date_created) >= corte);\n\nif (preguntas.length === 0) {\n  return [{ json: { hasQuestions: false, count: 0 } }];\n}\n\nreturn preguntas.map(q => ({\n  json: {\n    hasQuestions: true,\n    questionId: q.id,\n    texto: q.text,\n    itemId: q.item_id,\n  }\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800, 0],
