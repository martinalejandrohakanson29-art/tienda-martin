    {
      "parameters": {
        "jsCode": "// Lee en paralelo: listing_prices base, inputs y shipping_options\nconst baseItems   = $items(\"Calcular Fee\");            // listing_prices base\nconst inputItems  = $items(\"Code in JavaScript\");      // precios + tags\nconst shipItems   = $items(\"Envios\");                  // shipping_options\n\nfunction num(x, d=0){ const n = Number(x); return Number.isFinite(n) ? n : d; }\n\nfunction extraerEnvio(shipJson) {\n  const options = Array.isArray(shipJson?.options) ? shipJson.options : [];\n\n  // 1) opción a domicilio \"recommended\" o \"always\"\n  let sel = options.find(op =>\n    (op.display === \"recommended\" || op.display === \"always\") &&\n    op.shipping_option_type === \"address\"\n  );\n\n  // 2) si no hay, tomar la primera opción disponible\n  if (!sel && options.length) sel = options[0];\n\n  // defaults\n  let envio_pagado_comprador = 0;\n  let envio_list_cost = 8000; // fallback razonable\n\n  if (sel) {\n    const cost = num(sel.cost, 0);\n    const list_cost = num(sel.list_cost, 0);\n    // Si el comprador paga algo, tu costo es 0; si no paga, tu costo es el list_cost\n    envio_pagado_comprador = cost;\n    envio_list_cost = (cost > 0) ? 0 : list_cost;\n  }\n\n  return { envio_pagado_comprador, envio_list_cost };\n}\n\nreturn inputItems.map((up, idx) => {\n  const U = up.json || {};\n  const B = baseItems[idx]?.json;\n  const S = shipItems?.[idx]?.json;\n\n  // ---- listing_prices base ----\n  const baseObj = Array.isArray(B) ? (B[0] || {}) : (B || {});\n  const sale    = baseObj.sale_fee_details || {};\n\n  // % financiación (de listing_prices base)\n  const baseFin = (typeof sale.financing_add_on_fee === 'number')\n    ? Number(sale.financing_add_on_fee) : null;\n\n  // Monto total de fee devuelto por listing_prices (si viene)\n  const sale_fee_amount = (typeof baseObj.sale_fee_amount === 'number')\n    ? Number(baseObj.sale_fee_amount)\n    : null;\n\n  // % base (top-level o fallback al sale_fee_details)\n  const percentage_fee =\n    (typeof baseObj.percentage_fee === 'number')\n      ? Number(baseObj.percentage_fee)\n      : (typeof sale.meli_percentage_fee === 'number')\n          ? Number(sale.meli_percentage_fee)\n          : null;\n\n  // ---- decidir % cuotas (tu lógica final: tags -> base -> fallback) ----\n  let pct = (U.pctCuotas != null) ? Number(U.pctCuotas) : null;\n  let source = U.cuotasSource || null;\n\n  if (pct === null && baseFin !== null) {\n    pct = baseFin;\n    source = \"listing_prices:base\";\n  }\n  if (pct === null) {\n    pct = U.tiene_mshops_pcj ? 4 : 0;\n    source = U.tiene_mshops_pcj ? \"fallback:mshops 4%\" : \"none\";\n  }\n\n  const precioPublicado = num(U.precioPublicado, 0);\n  const costo_cuotas = +(precioPublicado * (pct / 100)).toFixed(2);\n\n  // ---- envío ----\n  const { envio_pagado_comprador, envio_list_cost } = extraerEnvio(S);\n\n  // ---- costo fijo estimado (derivado de listing_prices) ----\n  // Tomamos como precio base para el cálculo el mismo que usaste para llamar listing_prices base.\n  const precioParaFee = num(U.precioOriginal, precioPublicado);\n\n  const pct_base_fee   = num(\n    (typeof sale.meli_percentage_fee === 'number') ? sale.meli_percentage_fee : percentage_fee,\n    0\n  );\n  const pct_cuotas_fee = num(baseFin, 0);\n\n  let costo_fijo_est = null;\n  if (sale_fee_amount !== null) {\n    const partes_porcentuales = +(precioParaFee * ((pct_base_fee + pct_cuotas_fee) / 100)).toFixed(2);\n    costo_fijo_est = +(Math.max(0, sale_fee_amount - partes_porcentuales)).toFixed(2);\n  }\n\n  return {\n    json: {\n      item_id: U.item_id,\n\n      // cuotas (resultado final)\n      pct_cuotas: pct,\n      costo_cuotas,\n      cuotas_source: source,\n\n      // fees listing_prices base\n      sale_fee_amount,   // monto total de fee devuelto por listing_prices\n      percentage_fee,    // % base (si vino top-level; si no, lo cubre pct_base_fee abajo)\n\n      // envío\n      envio_list_cost,          // lo que te corresponde pagar si el comprador no paga\n      envio_pagado_comprador,   // lo que paga el comprador (si > 0, tu costo es 0)\n\n      // costo fijo estimado (derivado)\n      costo_fijo_est,\n      pct_base_fee,             // % base usado para calcular costo fijo\n      pct_cuotas_fee,           // % cuotas (de listing_prices base) usado para calcular costo fijo\n      precio_para_fee: precioParaFee\n    }\n  };\n});\n"
      },
