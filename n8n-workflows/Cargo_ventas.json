        "jsCode": "// Entrada: item del nodo \"Datos Item\"\n// Salida: inputs para fees + posibles decisiones rápidas de cuotas por tags\nreturn items.map(i => {\n  const it = i.json;\n\n  const precioOriginal  = Number(it.original_price ?? it.price ?? 0);\n  const precioPublicado = Number(it.price ?? it.original_price ?? 0);\n\n  const listing_type_id = it.listing_type_id || \"gold_special\";\n  const domain_id       = it.domain_id || \"\";\n\n  const tags = Array.isArray(it.tags) ? it.tags : [];\n\n  // Tags rápidos (idéntico a tu script)\n  let pctCuotas = null;\n  let cuotasSource = null;\n\n  if (tags.includes(\"pcj-co-funded\")) {\n    pctCuotas   = 4;\n    cuotasSource = \"tag:pcj-co-funded\";\n  } else if (tags.includes(\"pcj-buyer-funded\")) {\n    pctCuotas   = 0;\n    cuotasSource = \"tag:pcj-buyer-funded\";\n  }\n\n  // Tags de campaña que habilitan consulta con &tags=\n  const tagsCampanas = [\n    \"cuota-simple-3\", \"cuota-simple-6\", \"cuota-simple-12\",\n    \"3x_campaign\", \"9x_campaign\", \"12x_campaign\",\n    \"mshops_cuota-simple-3\", \"mshops_cuota-simple-6\",\n    \"mshops_3x_campaign\", \"mshops_9x_campaign\", \"mshops_12x_campaign\"\n  ];\n  const tagCampana = tags.find(t => tagsCampanas.includes(t)) || null;\n\n  // Seguimos pasando también el flag anterior por compatibilidad\n  const tiene_mshops_pcj = tags.includes(\"mshops_pcj-co-funded\");\n\n  return {\n    json: {\n      item_id: it.id,\n      // precios\n      precioOriginal,\n      precioPublicado,\n      // para listing_prices base & campaña\n      listing_type_id,\n      domain_id,\n      tagCampana,\n      // decisiones rápidas (si ya se puede resolver)\n      pctCuotas,      // 4, 0 o null\n      cuotasSource,   // texto debug del origen si ya quedó\n      // compat\n      tiene_mshops_pcj\n    }\n  };\n});\n"
      },
