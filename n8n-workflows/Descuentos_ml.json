    {
      "parameters": {
        "jsCode": "// Consolidar promos de /seller-promotions/items → 1 fila por MLA con la mejor promo \"started/active\"\n// Soporta: SMART, DOD, PRICE_DISCOUNT (ref_id null). Convierte strings a número y usa fallbacks.\n\nfunction num(x){ const n = Number(x); return Number.isFinite(n) ? n : null; }\nfunction r2(x){ const n = Number(x); return Number.isFinite(n) ? Number(n.toFixed(2)) : null; }\n\n// Este es el nodo que emite la lista de MLAs, en el MISMO orden de ejecución.\n// Cambiá el nombre si tu nodo upstream se llama distinto.\nconst UPSTREAM_NODE = \"Normalizar MLAs\";\n\n// Regex para extraer MLA cuando haya ref_id de tipo OFFER/CANDIDATE\nconst ITEM_RE = /(?:OFFER|CANDIDATE)-MLA(\\d+)-/;\n\n// 1) Leer TODA la entrada del Code (el HTTP puede entregar array o 1-por-ítem)\nconst inItems = $input.all();\n\n// 2) Aplanar promos y adjuntar item_id de contexto (fallback por índice)\nconst promos = [];\nfor (let i = 0; i < inItems.length; i++) {\n  const ctxItemId = $items(UPSTREAM_NODE)[i]?.json?.item_id || null; // p.ej. \"MLA123...\"\n  const v = inItems[i].json;\n\n  const pushPromo = (p) => {\n    // Intentar sacar el MLA desde ref_id si existe\n    let item_id = null;\n    const ref = String(p?.ref_id || \"\");\n    const m = ref.match(ITEM_RE);\n    if (m) item_id = \"MLA\" + m[1];\n    // Fallback: si no hay ref_id (PRICE_DISCOUNT), usar el item_id de contexto\n    if (!item_id) item_id = ctxItemId;\n    if (item_id) promos.push({ ...p, __item_id: item_id });\n  };\n\n  if (Array.isArray(v))        v.forEach(pushPromo);\n  else if (v?.results?.length) v.results.forEach(pushPromo);\n  else if (v && typeof v==='object') pushPromo(v);\n}\n\n// 3) Helpers de precio\nconst getOP = p => num(p?.original_price);\n// Para DOD a veces no hay \"price\" pero sí \"suggested_discounted_price\"\nconst getP  = p => (p?.price != null) ? num(p.price)\n                   : (p?.suggested_discounted_price != null ? num(p.suggested_discounted_price) : null);\n\n// Métrica para ordenar: preferir promos que tengan ambos valores y mayor descuento real\nfunction score(p){\n  const op = getOP(p), pr = getP(p);\n  if (op == null || pr == null) return -Infinity; // de última evitamos elegir promos sin datos clave\n  return op - pr;\n}\n\n// 4) Agrupar por ítem\nconst byItem = new Map();\nfor (const p of promos) {\n  const item_id = p.__item_id;\n  if (!item_id) continue;\n  if (!byItem.has(item_id)) byItem.set(item_id, []);\n  byItem.get(item_id).push(p);\n}\n\n// 5) Por ítem: filtrar started/active → elegir la mejor con datos válidos\nconst out = [];\nfor (const [item_id, arr] of byItem.entries()) {\n  const act = arr.filter(p => {\n    const st = String(p?.status || \"\").toLowerCase();\n    return st === \"started\" || st === \"active\";\n  });\n  if (!act.length) continue;\n\n  // Ordenar por \"score\" (mayor descuento con OP y P válidos)\n  act.sort((a,b) => score(b) - score(a));\n\n  // Tomar la primera con datos válidos; si ninguna tiene ambos, como fallback tomamos la primera \"started\"\n  let best = act.find(p => getOP(p)!=null && getP(p)!=null) || act[0];\n\n  const original_price = getOP(best);\n  const price          = getP(best);\n\n  // Si aún faltan datos clave, no emitimos (evita filas llenas de null)\n  if (original_price == null || price == null) continue;\n\n  const desc_abs_total = original_price - price;\n  const pct_descuento  = original_price > 0 ? r2(100 * desc_abs_total / original_price) : null;\n\n  // Split SOLO si lo trae /items (SMART suele traer; PRICE_DISCOUNT casi nunca)\n  const seller_percentage = num(best?.seller_percentage);\n  const meli_percentage   = num(best?.meli_percentage);\n\n  let seller_desc_abs = null, meli_desc_abs = null;\n  if (seller_percentage != null || meli_percentage != null) {\n    const s = seller_percentage || 0;\n    const m = meli_percentage   || 0;\n    const total = s + m;\n    if (total > 0) {\n      seller_desc_abs = r2(desc_abs_total * (s / total));\n      meli_desc_abs   = r2(desc_abs_total * (m / total));\n    }\n  }\n\n  out.push({\n    json: {\n      item_id,\n      promo_id: best?.id ?? null,\n      promo_type: best?.type ?? null,        // \"SMART\", \"DOD\", \"PRICE_DISCOUNT\", etc.\n      promo_status: best?.status ?? null,    // \"started\"\n      original_price,\n      price,                                 // precio final con descuento (o suggested si no venía \"price\")\n      pct_descuento,                         // % total\n      seller_percentage,                     // puede quedar null si la API no lo da (p.ej. PRICE_DISCOUNT)\n      meli_percentage,                       // idem\n      seller_desc_abs,\n      meli_desc_abs\n    }\n  });\n}\n\nreturn out;\n"
      },
