    {
      "parameters": {
        "jsCode": "const out = [];\nconst now = new Date();\n\nfunction isActivePromotion(p) {\n  if (p.type !== 'promotion') return false;\n  const startOk = !p.conditions?.start_time || new Date(p.conditions.start_time) <= now;\n  const endOk   = !p.conditions?.end_time   || now < new Date(p.conditions.end_time);\n  const ctx = p.conditions?.context_restrictions || [];\n  const channelOk = (ctx.length === 0) || ctx.includes('channel_marketplace');\n  return startOk && endOk && channelOk;\n}\n\nfunction preferMarketplaceStandard(p) {\n  if (p.type !== 'standard') return false;\n  const ctx = p.conditions?.context_restrictions || [];\n  return (ctx.length === 0) || ctx.includes('channel_marketplace');\n}\n\nfunction sortByLastUpdatedDesc(a, b) {\n  return new Date(b.last_updated || 0) - new Date(a.last_updated || 0);\n}\n\nfor (const item of $input.all()) {\n  const j = item.json;\n  const prices = Array.isArray(j.prices) ? j.prices : [];\n\n  const promoActiva   = prices.filter(isActivePromotion).sort(sortByLastUpdatedDesc)[0];\n  const stdMarket     = prices.filter(preferMarketplaceStandard).sort(sortByLastUpdatedDesc)[0];\n  const stdCualquiera = prices.filter(p => p.type === 'standard').sort(sortByLastUpdatedDesc)[0];\n\n  const precio_promo    = promoActiva?.amount ?? null;\n  const precio_standard = stdMarket?.amount ?? stdCualquiera?.amount ?? j.price ?? j.base_price ?? null;\n  const precio_final_calc = (precio_promo ?? precio_standard ?? null);\n\n  // --- CÁLCULO DE PORCENTAJE ---\n  let pct_descuento = 0;\n  if (precio_standard > 0 && precio_final_calc < precio_standard) {\n    pct_descuento = Number((((precio_standard - precio_final_calc) / precio_standard) * 100).toFixed(2));\n  }\n\n  out.push({\n    json: {\n      item_id: j.id || j.item_id,\n      precio_promo,\n      precio_standard,\n      precio_final_calc,\n      pct_descuento,\n      // En esta rama (/prices) no sabemos el split, \n      // asumimos que es 100% nuestro si hay rebaja manual.\n      seller_percentage: pct_descuento > 0 ? pct_descuento : null,\n      meli_percentage: 0\n    }\n  });\n}\n\nreturn out;"
      },
