    },
    {
      "parameters": {
        "jsCode": "// Lee el total de la primera página (activas) y genera un item por cada página necesaria\nconst p1 = $input.first().json;\nconst total = p1.paging?.total ?? 0;\nconst token = $('Edit Fields').first().json['Access Token'];\nconst sellerId = $('Edit Fields').first().json.seller_id;\nconst limit = 50;\nconst status = 'active';\n\nif (total === 0) return [];\n\nconst out = [];\nfor (let offset = 0; offset < total; offset += limit) {\n  out.push({ json: { offset, limit, token, sellerId, status } });\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [12336, 2000],
      "id": "a1e1c1a1-0001-4001-8001-000000000006",
