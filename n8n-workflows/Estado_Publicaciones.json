      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [13360, 2160],
      "id": "a1e1c1a1-0001-4001-8001-000000000012",
      "name": "Detalle items (batch)"
    },
    {
      "parameters": {
        "jsCode": "// La respuesta de /items?ids=... puede llegar como array o como items separados.\n// El status (active/paused) viene directo del detalle de ML: es el dato real y actual.\nconst results = [];\nfor (const item of $input.all()) {\n  const data = item.json;\n  const entries = Array.isArray(data) ? data : [data];\n  for (const r of entries) {\n    if (r && r.code === 200 && r.body) {\n      const b = r.body;\n      results.push({\n        json: {\n          item_id: b.id,\n          title: b.title,\n          price: b.price,\n          currency_id: b.currency_id,\n          available_quantity: b.available_quantity,\n          sold_quantity: b.sold_quantity,\n          condition: b.condition,\n          status: b.status,\n          listing_type_id: b.listing_type_id,\n          permalink: b.permalink\n        }\n      });\n    }\n  }\n}\nreturn results;"
      },
