      "name": "Merge estados"
    },
    {
      "parameters": {
        "jsCode": "// Junta los results de todas las páginas (activas + pausadas), deduplica IDs y arma batches de 20\nconst token = $('Edit Fields').first().json['Access Token'];\nconst allIds = [];\nconst seen = new Set();\nfor (const item of $input.all()) {\n  const results = item.json.results || [];\n  for (const id of results) {\n    if (!seen.has(id)) {\n      seen.add(id);\n      allIds.push(id);\n    }\n  }\n}\nif (allIds.length === 0) return [];\nconst out = [];\nfor (let i = 0; i < allIds.length; i += 20) {\n  out.push({ json: { ids_csv: allIds.slice(i, i + 20).join(','), token } });\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [13104, 2160],
      "id": "a1e1c1a1-0001-4001-8001-000000000011",
      "name": "Agrupar IDs en batches"
    },
    {
      "parameters": {
        "url": "=https://api.mercadolibre.com/items?ids={{$json.ids_csv}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$json.token}}" }
          ]
