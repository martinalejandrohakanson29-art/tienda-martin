    {
      "parameters": {
        "jsCode": "// Avisar sólo si hay preguntas recientes (N días) y NO borradas del listing.\nconst DIAS_RECIENTES = 2;\n\nconst ahora = new Date();\nconst corte = new Date(ahora.getTime() - DIAS_RECIENTES*24*60*60*1000);\n\nconst qs = ($json.questions || [])\n  .filter(q => q.status === 'UNANSWERED')\n  .filter(q => q.deleted_from_listing !== true)   // clave para matar “fantasmas”\n  .filter(q => new Date(q.date_created) >= corte);\n\nreturn [{\n  json: {\n    hasActionable: qs.length > 0,\n    count: qs.length,\n    sample: qs.slice(0, 3) // opcional, para debug\n  }\n}];\n"
      },
