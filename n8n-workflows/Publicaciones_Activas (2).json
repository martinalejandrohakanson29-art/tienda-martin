      "name": "Listar páginas"
    },
    {
      "parameters": {
        "jsCode": "// Junta todos los results de todas las páginas y arma batches de 20 IDs\nconst token = $('Edit Fields').first().json['Access Token'];\nconst allIds = [];\nfor (const item of $input.all()) {\n  const results = item.json.results || [];\n  allIds.push(...results);\n}\nif (allIds.length === 0) return [];\nconst out = [];\nfor (let i = 0; i < allIds.length; i += 20) {\n  out.push({ json: { ids_csv: allIds.slice(i, i + 20).join(','), token } });\n}\nreturn out;"
      },
