    {
      "parameters": {
        "jsCode": "const res = $input.first().json; // { statusCode, headers, body }\nconst itemId = $('Preparar PUT depósito').first().json.item_id;\nconst nuevoStock = $('Preparar PUT depósito').first().json.nuevo_stock;\n\nif (res.statusCode >= 200 && res.statusCode < 300) {\n  return [{ json: { success: true, item_id: itemId, available_quantity: nuevoStock } }];\n}\n\nconst mensaje = res.body?.message || res.body?.cause?.[0]?.message || 'Error al actualizar el stock del depósito en MercadoLibre';\nreturn [{ json: { success: false, error: `[PUT stock] ${mensaje}`, statusCode: res.statusCode } }];"
