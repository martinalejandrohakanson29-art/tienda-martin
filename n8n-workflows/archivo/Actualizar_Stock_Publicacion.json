      "name": "GET stock ubicaciones"
    },
    {
      "parameters": {
        "jsCode": "// Doc oficial ML \"Stock multi-origen\": separa Full (meli_facility, solo lectura) de\n// deposito propio (seller_warehouse / selling_address, editable). El x-version del GET\n// es obligatorio para el PUT siguiente (control de concurrencia optimista de ML).\nconst respGet = $input.first().json; // { statusCode, headers, body }\nconst itemId = $('Edit Fields').first().json.item_id;\nconst userProductId = $('Edit Fields').first().json.user_product_id;\n// Forzamos numero: si llega como string o undefined, JSON.stringify puede omitir\n// la clave \"quantity\" silenciosamente y ML responde \"quantity is required\".\nconst nuevoStock = Number($('Edit Fields').first().json.nuevo_stock);\nconst token = $('Edit Fields').first().json['Access Token'];\n\nif (respGet.statusCode < 200 || respGet.statusCode >= 300) {\n  const msg = respGet.body?.message || respGet.body?.cause?.[0]?.message || 'No se pudo leer el stock actual del depósito';\n  return [{ json: { error_previo: `[GET stock] ${msg}` } }];\n}\n\nif (!Number.isFinite(nuevoStock)) {\n  return [{ json: { error_previo: `nuevo_stock inválido: ${JSON.stringify($('Edit Fields').first().json.nuevo_stock)}` } }];\n}\n\nconst headers = respGet.headers || {};\nconst xVersionKey = Object.keys(headers).find(k => k.toLowerCase() === 'x-version');\nconst xVersion = xVersionKey ? headers[xVersionKey] : '';\n\nconst locations = respGet.body?.locations || [];\nconst depositoLocations = locations.filter(l => l.type === 'seller_warehouse' || l.type === 'selling_address');\n\nif (depositoLocations.length === 0) {\n  return [{ json: { error_previo: 'Este ítem no tiene depósito propio configurado en Mercado Libre (solo Full).' } }];\n}\n\nconst tipo = depositoLocations[0].type;\n// Doc \"Distributed Stock\": el PUT /stock/type/{type} espera { quantity } en la\n// raiz del body, no un array \"locations\" (eso es de la API distinta \"Multi-Origen\"\n// con store_id/network_node_id). Por eso ML devolvia \"quantity is required\".\n\nreturn [{\n  json: {\n    error_previo: '',\n    tipo,\n    x_version: xVersion,\n    locations_body: JSON.stringify({ quantity: nuevoStock }),\n    item_id: itemId,\n    user_product_id: userProductId,\n    nuevo_stock: nuevoStock,\n    token,\n  },\n}];"
      },
