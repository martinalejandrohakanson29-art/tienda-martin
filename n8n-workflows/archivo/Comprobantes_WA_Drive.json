    {
      "parameters": {
        "promptType": "define",
        "text": "=Analiza el siguiente mensaje de WhatsApp sobre una transferencia bancaria y extrae los datos indicados.\n\nMensaje: \"{{ $json.caption }}\"\n\nExtrae:\n- emisor: nombre completo de quien envía el dinero\n- receptor: nombre completo de quien recibe el dinero\n- monto: solo el número (sin puntos, comas ni símbolo $)\n- info_extra: cualquier otro dato relevante (número de CBU, alias, banco, etc.)\n\nSi algún campo no está claro, usa null.",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [560, -160],
      "id": "a1000005-0000-0000-0000-000000000005",
      "name": "AI Extraer caption"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "llama-3.3-70b-versatile",
          "mode": "list",
          "cachedResultName": "llama-3.3-70b-versatile"
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [560, 20],
      "id": "a1000006-0000-0000-0000-000000000006",
      "name": "LLM caption",
      "credentials": {
        "openAiApi": {
          "id": "izKqPEK5NVsAu3IE",
          "name": "OpenAi account 2"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"monto\": {\n      \"type\": \"number\",\n      \"description\": \"El monto total de la transferencia (solo el número, sin puntos ni comas)\"\n    },\n    \"emisor\": {\n      \"type\": \"string\",\n      \"description\": \"Nombre completo de quien envía el dinero\"\n    },\n    \"receptor\": {\n      \"type\": \"string\",\n      \"description\": \"Nombre completo de quien recibe el dinero\"\n    },\n    \"info_extra\": {\n      \"type\": \"string\",\n      \"description\": \"Cualquier dato adicional relevante como número de comprobante, banco, alias o CBU\"\n    }\n  },\n  \"required\": [\"monto\", \"emisor\", \"receptor\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [720, 20],
      "id": "a1000007-0000-0000-0000-000000000007",
      "name": "Parser caption"
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// ─── CONFIGURACIÓN ───────────────────────────────────────────────────────────\n// ⚠ Reemplazá estos dos valores antes de activar el workflow:\nconst EVOL_URL    = 'http://evo-r6g3c98f82vdigtfjnl2pxlw.187.77.224.120.sslip.io:8080';\nconst EVOL_INST   = 'EvolutionApi';\nconst EVOL_APIKEY = 'B7F9C7FE50E4-41C9-B35A-3E5A9A905C51';\n// ID de la carpeta raíz en Google Drive donde se crearán las subcarpetas por receptor:\nconst DRIVE_PARENT_ID = '1P3U-TWKAsn3wGDfaHpa3jBge8Myhpo6C';\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst campos   = $('Extraer campos').item.json;\nconst aiOutput = $json.output;\n\nconst receptor = (aiOutput.receptor || 'Receptor-Desconocido').trim();\nconst emisor   = (aiOutput.emisor   || 'Emisor-Desconocido').trim();\nconst mimeType = campos.mimeType || 'image/jpeg';\nconst ext      = mimeType.toLowerCase().includes('pdf') ? 'pdf' : 'jpg';\n\n// Generar nombre de archivo: YYYY-MM-DD_HH-mm_Emisor.ext\nconst ts       = new Date(campos.timestamp * 1000);\nconst dateStr  = ts.toISOString().slice(0, 10);\nconst timeStr  = ts.toISOString().slice(11, 16).replace(':', '-');\nconst slug     = emisor.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n                       .replace(/\\s+/g, '-')\n                       .replace(/[^a-zA-Z0-9\\-]/g, '')\n                       .slice(0, 30);\nconst nombreArchivo = `${dateStr}_${timeStr}_${slug}.${ext}`;\n\n// 1. Descargar media desde Evolution API\nconst mediaResp = await this.helpers.httpRequest({\n  method: 'POST',\n  url: `${EVOL_URL}/chat/getBase64FromMediaMessage/${EVOL_INST}`,\n  headers: {\n    'apikey': EVOL_APIKEY,\n    'Content-Type': 'application/json'\n  },\n  json: true,\n  body: {\n    message: {\n      key: {\n        id: campos.messageId,\n        remoteJid: campos.remoteJid,\n        fromMe: false\n      }\n    }\n  }\n});\n\nconst base64 = mediaResp.base64;\nif (!base64) throw new Error(`Evolution API no devolvió base64. Respuesta: ${JSON.stringify(mediaResp)}`);\nconst buffer = Buffer.from(base64, 'base64');\n\n// 2. Buscar carpeta del receptor en Drive (o crearla si no existe)\nconst searchResp = await this.helpers.httpRequestWithAuthentication.call(\n  this,\n  'googleDriveOAuth2Api',\n  {\n    method: 'GET',\n    url: 'https://www.googleapis.com/drive/v3/files',\n    qs: {\n      q: `name='${receptor}' and mimeType='application/vnd.google-apps.folder' and '${DRIVE_PARENT_ID}' in parents and trashed=false`,\n      fields: 'files(id,name)'\n    }\n  }\n);\n\nlet folderId;\nif (searchResp.files && searchResp.files.length > 0) {\n  folderId = searchResp.files[0].id;\n} else {\n  const createResp = await this.helpers.httpRequestWithAuthentication.call(\n    this,\n    'googleDriveOAuth2Api',\n    {\n      method: 'POST',\n      url: 'https://www.googleapis.com/drive/v3/files',\n      json: true,\n      body: {\n        name: receptor,\n        mimeType: 'application/vnd.google-apps.folder',\n        parents: [DRIVE_PARENT_ID]\n      }\n    }\n  );\n  folderId = createResp.id;\n}\n\n// 3. Preparar datos binarios para el nodo Google Drive Upload\nconst binaryData = await this.helpers.prepareBinaryData(\n  buffer,\n  nombreArchivo,\n  mimeType\n);\n\nreturn [{\n  json: {\n    monto:          aiOutput.monto,\n    emisor,\n    receptor,\n    info_extra:     aiOutput.info_extra || '',\n    nombre_archivo: nombreArchivo,\n    folderId,\n    messageId:      campos.messageId,\n    remoteJid:      campos.remoteJid,\n    pushName:       campos.pushName,\n    caption:        campos.caption\n  },\n  binary: {\n    data: binaryData\n  }\n}];"
      },
