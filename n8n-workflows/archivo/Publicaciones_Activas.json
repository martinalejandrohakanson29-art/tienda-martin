      "id": "57fe5b00-5a7f-435c-961a-297092528abf",
      "name": "Detalle items (batch)"
    },
    {
      "parameters": {
        "jsCode": "// La respuesta de /items?ids=... puede llegar como array o como items separados\nconst results = [];\nfor (const item of $input.all()) {\n  const data = item.json;\n  const entries = Array.isArray(data) ? data : [data];\n  for (const r of entries) {\n    if (r && r.code === 200 && r.body) {\n      const b = r.body;\n      results.push({\n        json: {\n          item_id: b.id,\n          title: b.title,\n          price: b.price,\n          currency_id: b.currency_id,\n          available_quantity: b.available_quantity,\n          sold_quantity: b.sold_quantity,\n          condition: b.condition,\n          status: b.status,\n          listing_type_id: b.listing_type_id,\n          permalink: b.permalink\n        }\n      });\n    }\n  }\n}\nreturn results;"
      },
