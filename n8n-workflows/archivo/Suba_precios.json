      "parameters": {
        "jsCode": "// Consolida resultados: separa OK de errores\n// Respuesta exitosa de PUT /items: el objeto del ítem con { id, price, ... }\nconst results = $input.all();\nconst ok = results.filter(r => r.json.id != null).length;\nconst errores = results.filter(r => r.json.id == null).map(r => r.json);\nreturn [{ json: { total: results.length, ok, errores } }];"
      },
