      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst items = Array.isArray(body.items) ? body.items : [];\n\n// Fila donde arrancan los datos reales en la pestaña \"Comparador\".\n// Verificado sobre la hoja: fila 1 vacía, fila 2 = encabezados (Item ID... FINAL), fila 3 = primer producto.\n// Si al probar ves que no coincide, ajustá SOLO este número.\nconst startRow = 3;\n\n// Rango generoso para poder limpiar filas viejas que ya no vengan en este envío\nconst maxClearRow = 5000;\n\nconst lastRow = items.length > 0 ? startRow + items.length - 1 : startRow;\n\nconst columnA = items.map(i => [i.mla ?? \"\"]);\nconst columnM = items.map(i => [Number(i.costo_total ?? 0)]);\n\nreturn [{\n  json: {\n    spreadsheetId: \"1AUw7IrTmuODu_WrogVienkxfUzG12j5DfH4jbMFvas0\",\n    sheetName: \"Comparador\",\n    clearRangeA: `Comparador!A${startRow}:A${maxClearRow}`,\n    clearRangeM: `Comparador!M${startRow}:M${maxClearRow}`,\n    updateRangeA: `Comparador!A${startRow}:A${lastRow}`,\n    updateRangeM: `Comparador!M${startRow}:M${lastRow}`,\n    columnA,\n    columnM,\n    total: items.length\n  }\n}];"
      },
