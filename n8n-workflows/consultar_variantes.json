    {
      "parameters": {
        "jsCode": "// Capturamos el objeto principal (el primer elemento del array que devuelve n8n)\nconst item = items[0].json;\n\n// 1. Caso: El producto TIENE VARIACIONES\nif (item.variations && item.variations.length > 0) {\n  return item.variations.map(variant => {\n    // Extraemos los nombres de los atributos (ej: \"MEDIDA: LEVA CORTA 69MM\")\n    const nombreAtributos = variant.attribute_combinations\n      ? variant.attribute_combinations.map(a => `${a.name}: ${a.value_name}`).join(\" - \")\n      : \"Sin nombre\";\n\n    return {\n      json: {\n        mla: item.id,\n        variation_id: variant.id.toString(),\n        // Extraemos el UP específico de esta variante\n        user_product_id: variant.user_product_id || null,\n        family_id: item.family_id || null, // ID de la familia (si existe)\n        \n        titulo: item.title,\n        nombre_variante: nombreAtributos,\n        precio: variant.price || item.price,\n        stock: variant.available_quantity,\n        logistic_type: item.shipping?.logistic_type || \"No especificado\",\n        permalink: item.permalink\n      }\n    };\n  });\n}\n\n// 2. Caso: El producto es ÚNICO (sin variaciones)\nreturn [{\n  json: {\n    mla: item.id,\n    variation_id: null,\n    // En productos únicos, el UP suele estar en la raíz\n    user_product_id: item.user_product_id || null,\n    family_id: item.family_id || null,\n    \n    titulo: item.title,\n    nombre_variante: \"Único\",\n    precio: item.price,\n    stock: item.available_quantity,\n    logistic_type: item.shipping?.logistic_type || \"No especificado\",\n    permalink: item.permalink\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
