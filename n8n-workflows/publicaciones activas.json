      "name": "Primera página"
    },
    {
      "parameters": {
        "jsCode": "// Lee el total de la primera página y genera un item por cada página necesaria\nconst p1 = $input.first().json;\nconst total = p1.paging?.total ?? 0;\nconst token = $('Edit Fields').first().json['Access Token'];\nconst sellerId = $('Edit Fields').first().json.seller_id;\nconst limit = 50;\n\nif (total === 0) return [];\n\nconst out = [];\nfor (let offset = 0; offset < total; offset += limit) {\n  out.push({ json: { offset, limit, token, sellerId } });\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1136, 0],
      "id": "c1c2c3c4-d5e6-7890-abcd-ef1234567892",
