  cilindradas_base      Int[]
}

model chat_combo_compatibilidad {
  id          Int      @id @default(autoincrement())
  grupo_id    Int?
  kit_id      Int?
  modelo_moto String
  compatible  Boolean
  detalle     String?
  creado_en   DateTime @default(now()) @db.Timestamptz(6)
}

model chat_config {
  clave           String    @id
  valor           String?
  actualizado_en  DateTime? @default(now()) @db.Timestamptz(6)
  actualizado_por String?
}

model chat_conversacion_estado {
  clave                      String    @id
  grupo_pineado_id           Int?
  grupo_pineado_nombre       String?
  variante_pack_id           Int?
  variante_etiqueta          String?
  variante_precio            Decimal?  @db.Decimal
  moto_confirmada            String?
  actualizado_en             DateTime  @default(now()) @db.Timestamptz(6)
  pack_presentado_id         Int?
  pack_presentado_nombre     String?
  pack_presentado_precio     Decimal?  @db.Decimal
  escalado_pendiente_motivo  String?
  escalado_pendiente_resumen String?
  escalado_pendiente_en      DateTime? @db.Timestamptz(6)
  negativa_moto              String?
  negativa_kit               String?
  negativa_detalle           String?
  negativa_en                DateTime? @db.Timestamptz(6)
  repreguntas_moto           Int?
  temas_respondidos          String[]
  moto_mencionada            String?
}

model chat_pack_articulos {
  id          Int        @id @default(autoincrement())
  pack_id     Int
  articulo_id Int
  cantidad    Int        @default(1)
  orden       Int        @default(0)
  chat_packs  chat_packs @relation(fields: [pack_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([pack_id, articulo_id])
}

model chat_pack_grupos {
  id                          Int          @id @default(autoincrement())
  nombre                      String
  plantillas_bienvenida       String?
  mensaje_bienvenida          String?
  activo                      Boolean      @default(true)
  creado_en                   DateTime     @default(now()) @db.Timestamptz(6)
  foto_url                    String?
  pregunta_variante           String?
  categoria                   String?
  compatibilidad_universal    Boolean?
  plantillas_referral         String?
  pregunta_variante_reintento String?
  cilindradas_base            Int[]
  chat_packs                  chat_packs[]
}

model chat_packs {
  id                       Int                   @id @default(autoincrement())
  nombre                   String
  precio                   Decimal               @default(0) @db.Decimal(12, 2)
  envio                    String?
  mensaje_bienvenida       String                @default("")
  foto_url                 String?
  plantillas_bienvenida    String?
  activo                   Boolean               @default(true)
  creado_en                DateTime              @default(now()) @db.Timestamptz(6)
  grupo_id                 Int?
  criterio_variante        String?
  detalle                  String?
  categoria                String?
  plantillas_referral      String?
  sinonimos_variante       String[]
  atributo_fijo            String?
  atributo_fijo_contradice String[]
  cilindradas_base         Int[]
  chat_pack_articulos      chat_pack_articulos[]
  chat_pack_grupos         chat_pack_grupos?     @relation(fields: [grupo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model chat_situaciones {
  id             Int       @id @default(autoincrement())
  clave          String?
  titulo         String?
  disparadores   String[]
  instruccion    String?
  activo         Boolean?  @default(true)
  orden          Int?
  creado_en      DateTime? @default(now()) @db.Timestamptz(6)
  actualizado_en DateTime? @default(now()) @db.Timestamptz(6)
}

model chatwoot_conversaciones_espejo {
  id                    BigInt   @id
  account_id            BigInt   @default(1)
  inbox_id              BigInt?
  nombre                String
  telefono              String   @default("")
  status                String   @default("open")
  ultimo_mensaje        String   @default("")
  ultimo_mensaje_propio Boolean  @default(false)
  no_leidos             Int      @default(0)
  bot_pausado           Boolean  @default(false)
  ultima_actividad      DateTime @default(now()) @db.Timestamptz(6)
  creado_en             DateTime @default(now()) @db.Timestamptz(6)
  actualizado_en        DateTime @default(now()) @db.Timestamptz(6)
  destacado             Boolean  @default(false)

  @@index([ultima_actividad(sort: Desc)], map: "idx_chatwoot_espejo_actividad")
  @@index([destacado], map: "idx_chatwoot_espejo_destacado")
  @@index([status], map: "idx_chatwoot_espejo_status")
  @@index([telefono], map: "idx_chatwoot_espejo_telefono")
}

model compatibilidades {
  id          Int       @id @default(autoincrement())
  modelo_moto String?
  kit         String?
  compatible  Boolean?
  detalle     String?
  fuente      String?
  creado_en   DateTime? @default(now()) @db.Timestamptz(6)
  kit_id      Int?
}

model bot_agente_entrantes_pendientes {
  conversation_id   BigInt    @id
  account_id        BigInt    @default(1)
  primer_mensaje_en DateTime  @default(now()) @db.Timestamptz(6)
  ultimo_mensaje_en DateTime  @default(now()) @db.Timestamptz(6)
  intentos          Int       @default(0)
  actualizado_en    DateTime  @default(now()) @db.Timestamptz(6)
  tomado_en         DateTime? @db.Timestamptz(6)

  @@index([ultimo_mensaje_en], map: "idx_bot_agente_entrantes_pendientes_ultimo")
}

model bot_cola_historico {
  id                       Int       @id @default(autoincrement())
  fecha                    DateTime  @db.Date
  bloque                   String
  mensajes_encolados       Int       @default(0)
  conversaciones_encoladas Int       @default(0)
  conversaciones_ids       BigInt[]  @default([])
  estado                   String    @default("acumulando")
  primero_en               DateTime? @db.Timestamptz(6)
  ultimo_en                DateTime? @db.Timestamptz(6)
  despachado_en            DateTime? @db.Timestamptz(6)
  creado_en                DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en           DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([fecha, bloque], map: "uq_bot_cola_historico_fecha_bloque")
  @@index([estado], map: "idx_bot_cola_historico_estado")
  @@index([fecha(sort: Desc)], map: "idx_bot_cola_historico_fecha")
}

model bot_agente_turnos_reales {
  id              Int      @id @default(autoincrement())
  conversation_id BigInt
  account_id      BigInt   @default(1)
  mensaje_cliente String
  respuesta_bot   String?
  foto_url        String?
  escalado_humano Boolean  @default(false)
  motivo_escalado String?
  herramientas    Json?
  latencia_ms     Int?
  resultado_envio String?
  detalle_envio   String?
  creado_en       DateTime @default(now()) @db.Timestamptz(6)
  tokens          Json?

  @@index([conversation_id, creado_en], map: "idx_bot_agente_turnos_reales_conv")
  @@index([creado_en], map: "idx_turnos_reales_creado_en")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}
