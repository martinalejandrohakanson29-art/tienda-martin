generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String             @id @default(cuid())
  username           String             @unique
  password           String
  name               String?
  role               Role               @default(USER)
  isActive           Boolean            @default(true)
  pushToken          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  todos              Todo[]
  notifRulesAsTarget NotificationRule[] @relation("NotificationRuleTarget")
  notifRulesAsSource NotificationRule[] @relation("NotificationRuleSource")
  notifications      Notification[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  eventType String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model NotificationRule {
  id           String   @id @default(cuid())
  name         String
  eventType    String
  sourceUserId String?
  targetUserId String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  targetUser   User     @relation("NotificationRuleTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  sourceUser   User?    @relation("NotificationRuleSource", fields: [sourceUserId], references: [id], onDelete: SetNull)
}

model Todo {
  id        String   @id @default(cuid())
  content   String
  completed Boolean  @default(false)
  isShared  Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  priority  String   @default("media")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("todos")
}

model Product {
  id              String   @id @default(cuid())
  title           String
  description     String
  price           Decimal
  stock           Int
  category        String
  imageUrl        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  discount        Int      @default(0)
  isFeatured      Boolean  @default(false)
  views           Int      @default(0)
  mercadolibreUrl String   @default("")
  imageUrl2       String   @default("")
  imageUrl3       String   @default("")
  videoUrl        String   @default("")
  showOnHome      Boolean  @default(false)
  order           Int      @default(0)
  freeShipping    Boolean  @default(true)
  isCombo         Boolean  @default(false)
}

model Config {
  id                    String   @id @default(cuid())
  companyName           String   @default("Mi Tienda")
  whatsappNumber        String   @default("")
  instagramUrl          String   @default("")
  tiktokUrl             String   @default("")
  welcomeText           String   @default("Bienvenido a nuestra tienda")
  locationUrl           String   @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  paymentMethods        String   @default("Efectivo,Transferencia,Tarjeta")
  carouselHeightDesktop String   @default("600px")
  carouselHeightMobile  String   @default("250px")
  logoUrl               String   @default("")
  logoHeight            String   @default("80px")
  announcementText      String   @default("")
  dolarCotizacion       Decimal  @default(1000) @db.Decimal(10, 2)
  factorFob             Decimal  @default(1.00) @db.Decimal(10, 2)
  recargoFinanciacion   Decimal  @default(0) @db.Decimal(10, 2)
}

model CarouselItem {
  id             String   @id @default(cuid())
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  mediaType      String   @default("image")
  mediaUrl       String   @default("")
  mediaUrlMobile String   @default("")
}

model Shipment {
  id        String         @id @default(cuid())
  name      String         @unique
  createdAt DateTime       @default(now())
  items     ShipmentItem[]
}

model ShipmentItem {
  id         String   @id @default(cuid())
  shipmentId String
  itemId     String
  title      String
  sku        String?
  quantity   Int
  agregados  String?
  imageUrl   String?
  variation  String?
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

model ShipmentAudit {
  id        String   @id @default(cuid())
  itemId    String
  envioId   String
  status    String
  reason    String?
  auditor   String?
  createdAt DateTime @default(now())

  @@unique([itemId, envioId])
}

// Auditoría de preparación de Pedidos de Venta (Venta tipoVenta=PEDIDO).
// A diferencia de ShipmentAudit (que es por ítem de envío ML), acá la evidencia
// es a nivel del pedido completo: una fila por venta. Las fotos viven en S3 bajo
// el prefijo auditoria-pedidos/{ventaId}/. status: FOTO_CARGADA | AUDITADO | RECHAZADO.
model PedidoVentaAudit {
  id        String   @id @default(cuid())
  ventaId   String   @unique
  status    String   @default("FOTO_CARGADA")
  uploader  String?
  auditor   String?
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pedido_venta_audit")
}

model CostosArticulos {
  id                  Int      @id @default(autoincrement())
  id_articulo         String   @unique
  descripcion         String?
  costo_usd           Decimal? @db.Decimal(10, 2)
  factor_fob          Decimal? @default(1.00) @db.Decimal(10, 2)
  es_dolar            Boolean? @default(true)
  costo_final_ars     Decimal? @db.Decimal(20, 2)
  fecha_actualizacion DateTime @default(now())

  @@map("costos_articulos_old")
}

model ProductosMaestros {
  id                   Int      @id @default(autoincrement())
  mla                  String
  variation_id         String?
  user_product_id      String?
  family_id            String?
  nombre_variante      String?
  nombre_publicacion   String?
  link_publicacion     String?
  estado               String?
  precio_venta_ml      Decimal? @db.Decimal(20, 2)
  es_nuevo             Boolean? @default(false)
  ultima_actualizacion DateTime @default(now())

  @@unique([mla, variation_id], name: "unique_mla_variation")
  @@index([user_product_id])
  @@index([family_id])
  @@map("productos_maestros_old")
}

model ComposicionKits {
  id              Int      @id @default(autoincrement())
  mla             String
  variation_id    String?
  nombre_variante String?
  id_articulo     String
  nombre_articulo String?
  cantidad        Int      @default(1)
  fecha_registro  DateTime @default(now())

  @@unique([mla, nombre_variante, id_articulo], name: "unique_kit_component")
  @@map("composicion_kits_old")
}

model SupplierProduct {
  id                String              @id @default(cuid())
  sku               String              @unique
  name              String
  updatedAt         DateTime            @updatedAt
  keywordBusqueda   String?
  seguimientoActivo Boolean             @default(false)
  stock             ImportStock?
  ventas            ImportVentas?
  kitComponents     KitComponent[]
  purchaseItems     PurchaseOrderItem[]
}

model SeguimientoPack {
  id              String   @id @default(cuid())
  mla             String   @unique
  nombre          String
  keywordBusqueda String?
  activo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("seguimiento_packs")
}

model ResultadoCompetencia {
  id              String   @id @default(cuid())
  tipo            String   // "ARTICULO" | "PACK"
  referencia      String   // sku del artículo o mla del pack rastreado
  keyword         String
  mlaId           String
  titulo          String
  precio          Decimal  @db.Decimal(20, 2)
  precioOriginal  Decimal? @db.Decimal(20, 2)
  vendedor        String?
  esTiendaOficial Boolean  @default(false)
  envio           String?
  cuotas          String?
  stock           String?
  link            String
  imagen          String?
  scrapedAt       DateTime @default(now())

  @@index([referencia, scrapedAt])
  @@map("resultados_competencia")
}

model ImportVentas {
  id            String          @id @default(cuid())
  sku           String          @unique
  salesLast30   Int             @default(0)
  salesVelocity Decimal?        @db.Decimal(10, 2)
  updatedAt     DateTime        @updatedAt
  product       SupplierProduct @relation(fields: [sku], references: [sku], onDelete: Cascade)
