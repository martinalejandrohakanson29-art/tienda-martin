generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String             @id @default(cuid())
  username             String             @unique
  password             String
  role                 Role               @default(USER)
  name                 String?
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  pushToken            String?
  notifRulesAsSource   NotificationRule[] @relation("NotificationRuleSource")
  notifRulesAsTarget   NotificationRule[] @relation("NotificationRuleTarget")
  credencialesCreadas  Credencial[]       @relation("CredencialCreadaPor")
  credencialesEditadas Credencial[]       @relation("CredencialEditadaPor")
  notifications        Notification[]
  todos                Todo[]
}

model Credencial {
  id              String   @id @default(cuid())
  categoria       String
  titulo          String
  usuario         String?
  passwordCifrada String
  url             String?
  notas           String?
  creadoPorId     String?
  editadoPorId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  creadoPor       User?    @relation("CredencialCreadaPor", fields: [creadoPorId], references: [id])
  editadoPor      User?    @relation("CredencialEditadaPor", fields: [editadoPorId], references: [id])

  @@map("credenciales")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  eventType String
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  link      String?
  groupId   String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([groupId])
  @@map("notifications")
}

model NotificationRule {
  id           String   @id @default(cuid())
  name         String
  eventType    String
  sourceUserId String?
  targetUserId String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sourceUser   User?    @relation("NotificationRuleSource", fields: [sourceUserId], references: [id])
  targetUser   User     @relation("NotificationRuleTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
}

model Todo {
  id        String   @id @default(cuid())
  content   String
  completed Boolean  @default(false)
  isShared  Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  priority  String   @default("media")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("todos")
}

model Product {
  id              String   @id @default(cuid())
  title           String
  description     String
  price           Decimal
  stock           Int
  category        String
  imageUrl        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  discount        Int      @default(0)
  isFeatured      Boolean  @default(false)
  views           Int      @default(0)
  mercadolibreUrl String   @default("")
  imageUrl2       String   @default("")
  imageUrl3       String   @default("")
  videoUrl        String   @default("")
  showOnHome      Boolean  @default(false)
  order           Int      @default(0)
  freeShipping    Boolean  @default(true)
  isCombo         Boolean  @default(false)
}

model Config {
  id                    String   @id @default(cuid())
  companyName           String   @default("Mi Tienda")
  whatsappNumber        String   @default("")
  instagramUrl          String   @default("")
  tiktokUrl             String   @default("")
  welcomeText           String   @default("Bienvenido a nuestra tienda")
  locationUrl           String   @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  paymentMethods        String   @default("Efectivo,Transferencia,Tarjeta")
  carouselHeightDesktop String   @default("600px")
  carouselHeightMobile  String   @default("250px")
  logoUrl               String   @default("")
  logoHeight            String   @default("80px")
  announcementText      String   @default("")
  dolarCotizacion       Decimal  @default(1000) @db.Decimal(10, 2)
  factorFob             Decimal  @default(1.00) @db.Decimal(10, 2)
  recargoFinanciacion   Decimal  @default(0) @db.Decimal(10, 2)
  showTrustBar          Boolean  @default(true)
  trust1Title           String?  @default("Envíos a Todo el País")
  trust1Desc            String?  @default("Por Correo Argentino, Andreani y Encomiendas")
  trust2Title           String?  @default("Medios de Pago")
  trust2Desc            String?  @default("Tarjetas de crédito, débito y transferencias con descuento")
  trust3Title           String?  @default("Asesoramiento Técnico")
  trust3Desc            String?  @default("Consultanos por WhatsApp y te guiamos en tu compra")
  trust4Title           String?  @default("Local en Córdoba")
  trust4Desc            String?  @default("Retiro en sucursal y atención personalizada")
  showSeoSection        Boolean  @default(true)
  seoTitle              String?  @default("Especialistas en Potenciación y Repuestos para Motos")
  seoSubtitle           String?  @default("Repuestos, cilindros, levas y kits de competición para talleres y particulares con envíos a toda Argentina.")
  seoText1              String?
  seoText2              String?
  seoTags               String?  @default("Honda, Yamaha, Motomel, Corven, Gilera, Bajaj, Kits de Potenciación, Cilindros, Levas, Carburadores, Escapes")
  showFaqSection        Boolean  @default(true)
}

model LandingFaq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@index([isActive])
  @@map("landing_faqs")
}

model CarouselItem {
  id             String   @id @default(cuid())
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  mediaType      String   @default("image")
  mediaUrl       String   @default("")
  mediaUrlMobile String   @default("")
}

model Shipment {
  id        String         @id @default(cuid())
  name      String         @unique
  createdAt DateTime       @default(now())
  items     ShipmentItem[]
}

model ShipmentItem {
  id         String   @id @default(cuid())
  shipmentId String
  itemId     String
  title      String
  sku        String?
  quantity   Int
  agregados  String?
  imageUrl   String?
  variation  String?
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

model ShipmentAudit {
  id        String   @id @default(cuid())
  itemId    String
  envioId   String
  status    String
  reason    String?
  auditor   String?
  createdAt DateTime @default(now())

  @@unique([itemId, envioId])
}

model PedidoVentaAudit {
  id        String   @id @default(cuid())
  ventaId   String   @unique
  status    String   @default("FOTO_CARGADA")
  uploader  String?
  auditor   String?
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pedido_venta_audit")
}

model CostosArticulos {
  id                  Int      @id @default(autoincrement())
  id_articulo         String   @unique
  descripcion         String?
  costo_usd           Decimal? @db.Decimal(10, 2)
  factor_fob          Decimal? @default(1.00) @db.Decimal(10, 2)
  es_dolar            Boolean? @default(true)
  costo_final_ars     Decimal? @db.Decimal(20, 2)
  fecha_actualizacion DateTime @default(now())

  @@map("costos_articulos_old")
}

model ProductosMaestros {
  id                   Int      @id @default(autoincrement())
  mla                  String
  variation_id         String?
  user_product_id      String?
  family_id            String?
  nombre_variante      String?
  nombre_publicacion   String?
  link_publicacion     String?
  estado               String?
  precio_venta_ml      Decimal? @db.Decimal(20, 2)
  ultima_actualizacion DateTime @default(now())
  es_nuevo             Boolean? @default(false)

  @@unique([mla, variation_id], name: "unique_mla_variation")
  @@index([user_product_id])
  @@index([family_id])
  @@map("productos_maestros_old")
}

model ComposicionKits {
  id              Int      @id @default(autoincrement())
  mla             String
  variation_id    String?
  nombre_variante String?
  id_articulo     String
  nombre_articulo String?
  cantidad        Int      @default(1)
  fecha_registro  DateTime @default(now())

  @@unique([mla, nombre_variante, id_articulo], name: "unique_kit_component")
  @@map("composicion_kits_old")
}

model SupplierProduct {
  id                String              @id @default(cuid())
  sku               String              @unique
  name              String
  updatedAt         DateTime            @updatedAt
  keywordBusqueda   String?
  seguimientoActivo Boolean             @default(false)
  stock             ImportStock?
  ventas            ImportVentas?
  kitComponents     KitComponent[]
  purchaseItems     PurchaseOrderItem[]
}

model SeguimientoPack {
  id              String   @id @default(cuid())
  mla             String   @unique
  nombre          String
  keywordBusqueda String?
  activo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("seguimiento_packs")
}

model ResultadoCompetencia {
  id              String   @id @default(cuid())
  tipo            String
  referencia      String
  keyword         String
  mlaId           String
  titulo          String
  precio          Decimal  @db.Decimal(20, 2)
  precioOriginal  Decimal? @db.Decimal(20, 2)
  vendedor        String?
  esTiendaOficial Boolean  @default(false)
  envio           String?
  cuotas          String?
  stock           String?
  link            String
  imagen          String?
  scrapedAt       DateTime @default(now())

  @@index([referencia, scrapedAt])
  @@map("resultados_competencia")
}

model ImportVentas {
  id            String          @id @default(cuid())
  sku           String          @unique
  salesLast30   Int             @default(0)
  salesVelocity Decimal?        @db.Decimal(10, 2)
  updatedAt     DateTime        @updatedAt
  product       SupplierProduct @relation(fields: [sku], references: [sku], onDelete: Cascade)
}

model ImportStock {
  id            String          @id @default(cuid())
  sku           String          @unique
  stockExternal Int             @default(0)
  updatedAt     DateTime        @updatedAt
  product       SupplierProduct @relation(fields: [sku], references: [sku], onDelete: Cascade)
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  externalId  String?
  supplier    String
  status      String
  arrivalDate DateTime?
  totalItems  Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  items       PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id                 String          @id @default(cuid())
  purchaseOrderId    String
  supplierProductSku String
  quantity           Int
  confirmed          Boolean         @default(false)
  purchaseOrder      PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supplierProduct    SupplierProduct @relation(fields: [supplierProductSku], references: [sku])
}

model KitComponent {
  id                 String          @id @default(cuid())
  mla                String
  variant            String?
  supplierProductSku String
  quantityPerKit     Int             @default(1)
  variation_id       String?
  supplierProduct    SupplierProduct @relation(fields: [supplierProductSku], references: [sku])

  @@index([mla])
  @@index([variation_id])
  @@index([supplierProductSku])
}

model ArticulosCompuestos {
  id             Int      @id @default(autoincrement())
  sku_padre      String
  sku_hijo       String
  cantidad       Int      @default(1)
  fecha_registro DateTime @default(now())

  @@unique([sku_padre, sku_hijo], name: "unique_parent_child")
  @@map("articulos_compuestos_old")
}

model PlanningSession {
  id        String   @id @default(cuid())
  dateFrom  DateTime
  dateTo    DateTime
  createdAt DateTime @default(now())
}

model InstagramSale {
  id                 String                      @id @default(cuid())
  id_comprobante     String                      @unique
  numero_comprobante String
  fecha              DateTime                    @default(now())
  total              Decimal                     @db.Decimal(20, 2)
  cliente            String
  dni                String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  envio              Decimal?                    @default(0) @db.Decimal(20, 2)
  metodo_pago        String?
  articulos          InstagramSaleItem[]
  paymentGroups      InstagramSalePaymentGroup[]

  @@map("instagram_sales")
}

model InstagramSalePaymentGroup {
  id          String                     @id @default(cuid())
  saleId      String
  metodo_pago String?
  monto_total Decimal                    @db.Decimal(20, 2)
  envio       Decimal                    @db.Decimal(20, 2)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  sale        InstagramSale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  articulos   InstagramSalePaymentItem[]

  @@map("instagram_sale_payment_groups")
}

model InstagramSalePaymentItem {
  id             String                    @id @default(cuid())
  paymentGroupId String
  tipo           String?
  detalle        String?
  marca          String?
  precio_neto    Decimal?                  @db.Decimal(20, 2)
  iva            Decimal?                  @db.Decimal(20, 2)
  precio_total   Decimal?                  @db.Decimal(20, 2)
  cantidad       Decimal?                  @db.Decimal(20, 2)
  paymentGroup   InstagramSalePaymentGroup @relation(fields: [paymentGroupId], references: [id], onDelete: Cascade)

  @@map("instagram_sale_payment_items")
}

model InstagramSaleItem {
  id           String        @id @default(cuid())
  detalle      String
  saleId       String
  precio_total Decimal?      @db.Decimal(20, 2)
  cantidad     Decimal       @db.Decimal(20, 2)
  sale         InstagramSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("instagram_sale_items")
}

model EtiquetaML {
  id             String           @id
  orderId        String?
  logisticType   String?
  status         String           @default("PENDIENTE")
  substatus      String?
  resumen        String?
  auditor        String?
  drivePhotoUrl  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  payBefore      DateTime?
  fechaPreparado DateTime?
  packId         String?
  items          EtiquetaMLItem[]

  @@map("etiquetas_ml")
}

model EtiquetaMLItem {
  id         String     @id @default(cuid())
  etiquetaId String
  mla        String
  title      String
  sku        String?
  quantity   Int
  variation  String?
  etiqueta   EtiquetaML @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)

  @@index([etiquetaId])
  @@map("etiquetas_ml_items")
}

model MLFees {
  mla                  String   @id
  cargo_venta_fijo     Decimal? @db.Decimal(20, 2)
  cargo_venta_percent  Decimal? @db.Decimal(10, 2)
  cuotas_fijo          Decimal? @db.Decimal(20, 2)
  cuotas_percent       Decimal? @db.Decimal(10, 2)
  envio_costo          Decimal? @db.Decimal(20, 2)
  costo_fijo_ml        Decimal? @db.Decimal(20, 2)
  ultima_actualizacion DateTime @default(now())

  @@map("ml_fees")
}

model MLDescuentos {
  mla                  String   @id
  original_price       Decimal? @db.Decimal(20, 2)
  precio_final         Decimal? @db.Decimal(20, 2)
  pct_descuento        Decimal? @db.Decimal(10, 2)
  seller_percentage    Decimal? @db.Decimal(10, 2)
  meli_percentage      Decimal? @db.Decimal(10, 2)
  descuento_propio     String?
  ultima_actualizacion DateTime @default(now())

  @@map("ml_descuentos")
}

model MLMeliPlus {
  mla                        String    @id
  original_price             Decimal?  @db.Decimal(20, 2)
  min_discounted_price       Decimal?  @db.Decimal(20, 2)
  max_discounted_price       Decimal?  @db.Decimal(20, 2)
  suggested_discounted_price Decimal?  @db.Decimal(20, 2)
  start_date                 DateTime?
  finish_date                DateTime?
  status                     String?
  ultima_actualizacion       DateTime  @default(now())

  @@map("ml_meli_plus")
}

model MarketingCampaign {
  id          String                  @id
  name        String
  spend       Decimal                 @db.Decimal(20, 2)
  reach       Int                     @default(0)
  messages    Int                     @default(0)
  carts       Int                     @default(0)
  status      String                  @default("Active")
  updatedAt   DateTime                @updatedAt
  impressions Int                     @default(0)
  clicks      Int                     @default(0)
  cpc         Decimal?                @db.Decimal(10, 2)
  ctr         Decimal?                @db.Decimal(10, 2)
  frequency   Decimal?                @db.Decimal(10, 2)
  rawActions  Json?
  adSets      Json?
  cpm         Decimal?                @db.Decimal(10, 2)
  createdTime DateTime?
  startTime   DateTime?
  dateStart   DateTime?
  dateStop    DateTime?
  items       MarketingCampaignItem[]

  @@map("marketing_campaigns")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model MarketingCampaignItem {
  id         String            @id @default(cuid())
  campaignId String
  articuloId String
  createdAt  DateTime          @default(now())
  adId       String?
  articulo   ArticuloMostrador @relation(fields: [articuloId], references: [id], onDelete: Cascade)
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([adId])
  @@index([articuloId])
  @@map("marketing_campaign_items")
}

model MarketingAutoResponse {
  id        String   @id @default(cuid())
  adId      String   @unique
  name      String
  response  String
  updatedAt DateTime @updatedAt

  @@map("marketing_auto_responses")
}

model ReglaAjustePrecio {
  id             String   @id @default(cuid())
  nombre         String
  prioridad      Int      @default(100)
  activa         Boolean  @default(true)
  tipo           String
  margenMin      Decimal? @db.Decimal(10, 2)
  margenMax      Decimal? @db.Decimal(10, 2)
  ventasMin      Int?
  ventasMax      Int?
  targetGanancia Decimal? @db.Decimal(10, 2)
  subaPct        Decimal? @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("reglas_ajuste_precio")
}

model RentabilidadCalculada {
  id                   String   @id @default(cuid())
  mla                  String
  variation_id         String?
  nombre               String
  nombre_variante      String?
  precio_original      Decimal  @db.Decimal(20, 2)
  desc_pct_total       Decimal  @db.Decimal(10, 2)
  precio_final         Decimal  @db.Decimal(20, 2)
  costo_total          Decimal  @db.Decimal(20, 2)
  neto_teorico         Decimal  @db.Decimal(20, 2)
  ganancia_neta        Decimal  @db.Decimal(20, 2)
  ganancia_porcentaje  Decimal  @db.Decimal(10, 2)
  fecha_actualizacion  DateTime @default(now())
  precio_final_nuestro Decimal  @db.Decimal(20, 2)

  @@unique([mla, variation_id])
  @@map("rentabilidad_calculada")
}

model SnapshotPrecios {
  id        String               @id @default(cuid())
  nombre    String
  createdAt DateTime             @default(now())
  items     SnapshotPrecioItem[]

  @@map("snapshots_precios")
}

model SnapshotPrecioItem {
  id             String          @id @default(cuid())
  snapshotId     String
  mla            String
  nombre         String
  nombreVariante String?
  ajustePct      Decimal         @db.Decimal(10, 2)
  precioOriginal Decimal         @db.Decimal(20, 2)
  nuevoPrecio    Decimal         @db.Decimal(20, 2)
  snapshot       SnapshotPrecios @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@map("snapshot_precio_items")
}

model Venta {
  id                String           @id @default(cuid())
  cliente           String           @default("Consumidor Final")
  vendedor          String           @default("Martin Jakson")
  total             Decimal          @default(0) @db.Decimal(20, 2)
  metodo_pago       String           @default("Efectivo")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  cupon             String?
  de                String?
  dni               String?
  info              String?
  para              String?
  telefono          String?
  transaccionId     String?
  registrada        Boolean          @default(false)
  interes           Decimal          @default(0) @db.Decimal(10, 2)
  totalFinal        Decimal          @default(0) @db.Decimal(20, 2)
  email             String?
  eventoOffline     Boolean          @default(false)
  puntoVentaId      String?
  tipoVenta         String?          @default("CONFIRMADA")
  estadoPedido      String?          @default("PENDIENTE")
  pdfUrl            String?
  numeroVenta       Int              @unique @default(autoincrement())
  alicuotaIva       Int?
  cae               String?
  condicionIva      Int?
  docNro            String?
  docTipo           Int?
  facturaNumero     Int?
  facturaPuntoVenta Int?             @default(9)
  importeIva        Decimal?         @db.Decimal(20, 2)
  tipoComprobante   Int?
  vencimientoCae    DateTime?
  sujetoId          String?
  mlIdEnvio         String?
  mlIdVenta         String?          @unique
  mlMla             String?
  mlDni             String?
  mlPackId          String?
  tipoEnvio         String           @default("andreani")
  mlAlerta          Boolean          @default(false)
  mlObservacion     String?
  comprobantes      Comprobante[]
  auditorias        VentaAuditoria[]
  puntoVenta        PuntoVenta?      @relation(fields: [puntoVentaId], references: [id])
  sujeto            Proveedor?       @relation(fields: [sujetoId], references: [id])
  items             VentaItem[]

  @@map("ventas_mostrador")
}

model Comprobante {
  id             String    @id @default(cuid())
  ventaId        String
  tipo           Int
  puntoVenta     Int       @default(9)
  numero         Int
  cae            String
  vencimientoCae DateTime?
  docTipo        Int?
  docNro         String?
  condicionIva   Int?
  cliente        String?
  total          Decimal   @db.Decimal(20, 2)
  neto           Decimal?  @db.Decimal(20, 2)
  importeIva     Decimal?  @db.Decimal(20, 2)
  asociadoTipo   Int?
  asociadoPtoVta Int?
  asociadoNumero Int?
  anulado        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  venta          Venta     @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  @@index([ventaId])
  @@map("comprobantes")
}

model VentaItem {
  id          String  @id @default(cuid())
  ventaId     String
  productoId  String?
  nombre      String
  cantidad    Int     @default(1)
  precio_unit Decimal @db.Decimal(20, 2)
  subtotal    Decimal @db.Decimal(20, 2)
  esNota      Boolean @default(false)
  venta       Venta   @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  @@map("ventas_mostrador_items")
}

model VentaAuditoria {
  id        String   @id @default(cuid())
  ventaId   String
  usuario   String
  accion    String
  detalle   String?
  createdAt DateTime @default(now())
  venta     Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  @@map("ventas_auditoria")
}

model ArticuloMostrador {
  id                   String                  @id @default(cuid())
  nombre               String
  stock                Int                     @default(0)
  precio               Decimal                 @default(0) @db.Decimal(20, 2)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  esPack               Boolean?                @default(false)
  costo                Decimal?                @default(0) @db.Decimal(20, 2)
  margenGanancia       Decimal?                @default(0) @db.Decimal(10, 2)
  oculto               Boolean                 @default(false)
  codigoProveedor      String?
  proveedorId          String?
