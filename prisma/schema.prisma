  @@map("seguimiento_ventas")
}

model ItemVisitaDiaria {
  id      String   @id @default(cuid())
  mla     String
  fecha   DateTime
  visitas Int

  @@unique([mla, fecha])
  @@map("item_visitas_diarias")
}

model DescripcionPublicacion {
  mla                 String   @id
  titulo              String?
  descripcion         String   @default("") @db.Text
  permalink           String?
  estado              String?  @default("active")
  fecha_actualizacion DateTime @default(now())

  @@index([estado])
  @@map("descripcion_publicacion")
}

model Compra {
  id            String            @id @default(cuid())
  proveedor     String            @default("Proveedor General")
  comprador     String            @default("Usuario General")
  total         Decimal           @default(0) @db.Decimal(20, 2)
  metodo_pago   String            @default("Efectivo")
  info          String?
  comprobante   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  descuento     Decimal           @default(0) @db.Decimal(10, 2)
  dni           String?
  interes       Decimal           @default(0) @db.Decimal(10, 2)
  numeroCompra  Int               @unique @default(autoincrement())
  proveedorId   String?
  registrada    Boolean           @default(false)
  telefono      String?
  totalFinal    Decimal           @default(0) @db.Decimal(20, 2)
  transaccionId String?
  estadoPedido  String?           @default("PENDIENTE")
  pdfUrl        String?
  tipoCompra    String?           @default("CONFIRMADA")
  fechaIngreso  DateTime?
  fechaCarga    DateTime          @default(now())
  auditorias    CompraAuditoria[]
  proveedorRel  Proveedor?        @relation(fields: [proveedorId], references: [id])
  items         CompraItem[]

  @@map("compras_mostrador")
}

model CompraItem {
  id         String  @id @default(cuid())
  compraId   String
  productoId String?
  nombre     String
  cantidad   Int     @default(1)
  costo_unit Decimal @db.Decimal(20, 2)
  subtotal       Decimal  @db.Decimal(20, 2)
  margenGanancia Decimal? @db.Decimal(10, 2)
  compra         Compra  @relation(fields: [compraId], references: [id], onDelete: Cascade)

  @@map("compras_mostrador_items")
}

model CompraAuditoria {
  id        String   @id @default(cuid())
  compraId  String
  usuario   String
  accion    String
  detalle   String?
  createdAt DateTime @default(now())
  compra    Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)

  @@map("compras_auditoria")
}

model Contacto {
  id             String   @id @default(cuid())
  razonSocial    String?
  apellido       String?
  nombre         String?
  nombreFantasia String?
  telefono       String?
  cuit           String?
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}


model WebSale {
  id          String        @id @default(cuid())
  paymentId   String?       @map("payment_id")
  status      String        @default("PENDIENTE")
  total       Decimal       @db.Decimal(20, 2)
  nombre      String?
  dni         String?
  email       String?
  telefono    String?
  domicilio   String?
  ciudad      String?
  provincia   String?
  cp          String?
  referencias String?
  
  // Datos MercadoPago (ML)
  mlIdVenta   String?
  mlIdEnvio   String?
  mlMla       String?
  mlDni       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       WebSaleItem[]

  @@map("ventas_web")
}

model WebSaleItem {
  id          String  @id @default(cuid())
  webSaleId   String  @map("web_sale_id")
  productoId  String? @map("producto_id")
  nombre      String
  cantidad    Int     @default(1)
  precio_unit Decimal @db.Decimal(20, 2)
  subtotal    Decimal @db.Decimal(20, 2)
  webSale     WebSale @relation(fields: [webSaleId], references: [id], onDelete: Cascade)

  @@map("ventas_web_items")
}

model ConversacionRespondida {
