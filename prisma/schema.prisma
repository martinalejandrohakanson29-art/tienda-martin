// Reglas configurables para el motor de ajuste de precios de la sección Rentabilidad.
// Se evalúan por prioridad ascendente (menor = primero); la primera regla activa
// cuyas condiciones (AND) matcheen define la acción sugerida para esa publicación.
model ReglaAjustePrecio {
  id        String  @id @default(cuid())
  nombre    String
  prioridad Int     @default(100) // menor = se evalúa antes
  activa    Boolean @default(true)
  tipo      String // "DESCUENTO" | "SUBA"

  // Condiciones (todas opcionales, se combinan con AND). Margen = ganancia %.
  margenMin Decimal? @db.Decimal(10, 2)
  margenMax Decimal? @db.Decimal(10, 2)
  ventasMin Int?
  ventasMax Int?

  // Acción según tipo:
  //  - DESCUENTO: targetGanancia = margen % al que se quiere llevar (baja precio vía promoción)
  //  - SUBA:      subaPct = % de aumento fijo sobre el precio de lista (sube price real)
  targetGanancia Decimal? @db.Decimal(10, 2)
  subaPct        Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reglas_ajuste_precio")
}

model RentabilidadCalculada {
  id                   String   @id @default(cuid())
  mla                  String
  variation_id         String?
  nombre               String
  nombre_variante      String?
  precio_original      Decimal  @db.Decimal(20, 2)
  desc_pct_total       Decimal  @db.Decimal(10, 2)
  precio_final         Decimal  @db.Decimal(20, 2)
  costo_total          Decimal  @db.Decimal(20, 2)
  neto_teorico         Decimal  @db.Decimal(20, 2)
  ganancia_neta        Decimal  @db.Decimal(20, 2)
  ganancia_porcentaje  Decimal  @db.Decimal(10, 2)
  fecha_actualizacion  DateTime @default(now())
  precio_final_nuestro Decimal  @db.Decimal(20, 2)

  @@unique([mla, variation_id])
  @@map("rentabilidad_calculada")
}

model Venta {
  id            String           @id @default(cuid())
  cliente       String           @default("Consumidor Final")
  vendedor      String           @default("Martin Jakson")
  total         Decimal          @default(0) @db.Decimal(20, 2)
  metodo_pago   String           @default("Efectivo")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  cupon         String?
  de            String?
  dni           String?
  info          String?
  para          String?
  telefono      String?
  transaccionId String?
  registrada    Boolean          @default(false)
  interes       Decimal          @default(0) @db.Decimal(10, 2)
  totalFinal    Decimal          @default(0) @db.Decimal(20, 2)
  email         String?
  eventoOffline Boolean          @default(false)
  puntoVentaId  String?
  tipoVenta     String?          @default("CONFIRMADA")
  estadoPedido  String?          @default("PENDIENTE")
  pdfUrl        String?
  numeroVenta   Int              @unique @default(autoincrement())
  tipoEnvio     String           @default("andreani")
  
  // Datos Legales ARCA
  cae             String?
  vencimientoCae  DateTime?
  facturaNumero   Int?
  facturaPuntoVenta Int?         @default(9)
  tipoComprobante Int?           // 1=A, 6=B, 11=C, etc.
  
  // Datos del Cliente para QR y Cabecera
  docTipo         Int?           // 80, 96, 99
  docNro          String?        // CUIT o DNI
  condicionIva    Int?           // 1, 5, 6
  
  // Datos MercadoPago (ML)
  mlIdVenta       String?
  mlIdEnvio       String?
  mlPackId        String?
  mlMla           String?
  mlDni           String?
  mlAlerta        Boolean          @default(false)
  mlObservacion   String?
  
  // Desglose Impositivo (Snapshot)
  importeIva      Decimal?       @db.Decimal(20, 2)
  alicuotaIva     Int?           // ID de alícuota
  
  sujetoId      String?
  sujeto        Proveedor?       @relation(fields: [sujetoId], references: [id])

  auditorias    VentaAuditoria[]
  puntoVenta    PuntoVenta?      @relation(fields: [puntoVentaId], references: [id])
  items         VentaItem[]
  comprobantes  Comprobante[]

  @@map("ventas_mostrador")
}

// Historial de comprobantes ARCA emitidos para una venta.
// 1 fila por comprobante (Factura B, Nota de Crédito, Factura A, etc.).
// La Venta mantiene los campos cae/facturaNumero/tipoComprobante apuntando
// al comprobante VIGENTE; esta tabla guarda la trazabilidad fiscal completa.
model Comprobante {
  id             String    @id @default(cuid())
  ventaId        String
  venta          Venta     @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  tipo           Int       // 6=Fact B, 1=Fact A, 8=NC B, 3=NC A, 11=Fact C, 13=NC C
  puntoVenta     Int       @default(9)
  numero         Int
  cae            String
  vencimientoCae DateTime?

  // Snapshot del receptor y montos al momento de emitir
  docTipo        Int?      // 80=CUIT, 96=DNI, 99=CF
  docNro         String?
  condicionIva   Int?
  cliente        String?
  total          Decimal   @db.Decimal(20, 2)
  neto           Decimal?  @db.Decimal(20, 2)
  importeIva     Decimal?  @db.Decimal(20, 2)

  // Si es Nota de Crédito: a qué comprobante anula
  asociadoTipo   Int?
  asociadoPtoVta Int?
  asociadoNumero Int?

  anulado        Boolean   @default(false)  // true si este comprobante fue anulado por una NC
  createdAt      DateTime  @default(now())

  @@index([ventaId])
  @@map("comprobantes")
}

model VentaItem {
  id          String  @id @default(cuid())
  ventaId     String
  productoId  String?
  nombre      String
  cantidad    Int     @default(1)
  precio_unit Decimal @db.Decimal(20, 2)
